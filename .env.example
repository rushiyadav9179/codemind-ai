# =============================================================================
# CodeMind AI — Environment Configuration
# =============================================================================
NODE_ENV=development
APP_NAME=CodeMind AI
APP_VERSION=0.1.0

# ── API Server ────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=localhost
# Keep 0 unless a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY_HOPS=0

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Database (PostgreSQL + pgvector) ─────────────────────────────────────
DATABASE_URL=postgresql://codemind:changeme@localhost:5432/codemind_dev

# ── PostgreSQL Container Settings ─────────────────────────────────────────
POSTGRES_USER=codemind
POSTGRES_PASSWORD=changeme
POSTGRES_DB=codemind_dev
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Authentication ───────────────────────────────────────────────────────
# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_JWT_ISSUER=codemind-ai
AUTH_JWT_AUDIENCE=codemind-ai-web
# Set true in production; false is permitted only for local HTTP development
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Tests require a dedicated database whose name ends in _test.
TEST_DATABASE_URL=postgresql://codemind:changeme@localhost:5432/codemind_test?schema=public
