# =============================================================================
# CodeMind AI — Environment Configuration
# =============================================================================
NODE_ENV=development
APP_NAME=CodeMind AI
APP_VERSION=0.1.0

# ── API Server ────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=localhost

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Database (PostgreSQL + pgvector) ─────────────────────────────────────
DATABASE_URL=postgresql://codemind:changeme@localhost:5432/codemind_dev

# ── PostgreSQL Container Settings ─────────────────────────────────────────
POSTGRES_USER=codemind
POSTGRES_PASSWORD=changeme
POSTGRES_DB=codemind_dev
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
