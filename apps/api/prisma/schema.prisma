generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum RepositorySourceType {
  MANUAL
}

enum RepositoryStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(254)
  passwordHash  String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  repositories  Repository[]
}

model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  csrfTokenHash String    @db.Char(64)
  familyId      String    @db.Uuid
  userId        String    @db.Uuid
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

enum AnalysisStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model Repository {
  id            String               @id @default(uuid()) @db.Uuid
  ownerId       String               @db.Uuid
  name          String               @db.VarChar(100)
  description   String?              @db.VarChar(500)
  sourceType    RepositorySourceType @default(MANUAL)
  defaultBranch String               @default("main") @db.VarChar(100)
  language      String?              @db.VarChar(50)
  status        RepositoryStatus     @default(ACTIVE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  owner         User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  analysisRuns  AnalysisRun[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([ownerId, createdAt])
}

model AnalysisRun {
  id           String         @id @default(uuid()) @db.Uuid
  repositoryId String         @db.Uuid
  status       AnalysisStatus @default(PENDING)
  totalFiles   Int            @default(0)
  totalLines   Int            @default(0)
  summary      Json?
  error        String?
  createdAt    DateTime       @default(now())
  completedAt  DateTime?
  repository   Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  files        AnalyzedFile[]

  @@index([repositoryId])
  @@index([repositoryId, createdAt])
}

model AnalyzedFile {
  id            String      @id @default(uuid()) @db.Uuid
  analysisRunId String      @db.Uuid
  filePath      String      @db.VarChar(500)
  language      String      @db.VarChar(50)
  lineCount     Int         @default(0)
  codeLineCount Int         @default(0)
  imports       Json        @default("[]")
  exports       Json        @default("[]")
  symbols       Json        @default("{}")
  dependencies  Json        @default("[]")
  hasErrors     Boolean     @default(false)
  analysisRun   AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@unique([analysisRunId, filePath])
  @@index([analysisRunId])
  @@index([analysisRunId, language])
}

